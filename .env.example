# Copy to .env in the repo root. The classifier reads it automatically.
# .env values override inherited shell values; app password overrides take precedence.
# These settings are not exported to the separate action-level Gemini advisor.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
GEMINI_API_KEY=
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
