# Copy to .env in the repo root. Values override inherited shell settings.
# Explicit nonblank API arguments / classifier password overrides take precedence.
# Empty .env keys disable inherited keys. Reading settings never exports them.
# Each remote UI route requires its own explicit button; configuring a key is not consent to call.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
GEMINI_API_KEY=
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Separate advice models: set models your project is authorized to use.
GEMINI_EXPLANATION_MODEL=gemini-2.5-flash
GEMINI_ADVISOR_MODEL=gemini-2.5-flash
